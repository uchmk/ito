{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uchmk/ito/docs/schemas/vision.v1.json",
  "title": "ito vision v1",
  "description": "One Vision opinion on a row's screenshots, as stored after the caller filled the provenance. An opinion, never a measurement: on its own it changes no mark. Tier 2 verdicts cross-check it against the machine's evidence (evidence.py). One answer covers one image. Not checked here: point ids are unique, image names an inputs id, overall follows from points (FAIL if any point is FAIL, else INCONCLUSIVE if any is, counting a PASS with a null bbox_px, else PASS).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "vision.v1"
    },
    "row": {
      "type": "string"
    },
    "model": {
      "description": "The model that answered. The subagent's raw answer has null here and the caller fills it before storing.",
      "type": "string"
    },
    "prompt_sha256": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Blind name such as A or B; which file it is, and whether it is a canary, stays in the caller's record",
            "type": "string"
          },
          "sha256": {
            "description": "SHA-256 of the image, which ties the blind id to the real file",
            "type": "string"
          }
        },
        "required": [
          "id",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "verdict": {
            "$ref": "#/$defs/verdict"
          },
          "bbox_px": {
            "$ref": "#/$defs/bbox"
          },
          "saw": {
            "description": "What was seen there. For a question that reads text, the text exactly as read.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "image",
          "question",
          "verdict",
          "bbox_px",
          "saw"
        ],
        "additionalProperties": false
      }
    },
    "unexpected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string"
          },
          "bbox_px": {
            "$ref": "#/$defs/bbox"
          },
          "saw": {
            "type": "string"
          }
        },
        "required": [
          "image",
          "bbox_px",
          "saw"
        ],
        "additionalProperties": false
      }
    },
    "overall": {
      "$ref": "#/$defs/verdict"
    },
    "usage": {
      "description": "Null when the caller cannot get the split.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema",
    "row",
    "model",
    "prompt_sha256",
    "inputs",
    "points",
    "unexpected",
    "overall",
    "usage"
  ],
  "additionalProperties": false,
  "$defs": {
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "bbox": {
      "description": "[x, y, w, h] in the pixels of the image given to Vision (of the crop, for a crop). Null when no location could be given: a PASS without a location counts as INCONCLUSIVE, and a FAIL stays FAIL.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      ]
    }
  }
}
